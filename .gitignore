# secrets — RUNPOD_API_KEY and the S3 keys live here, never commit
.env
*.key
.rp_key

# environments
.venv/
__pycache__/
*.pyc

# Model weights and galleries. These are hundreds of MB and several exceed
# GitHub's 100 MB hard limit; they are distributed via the S3 bucket instead
# (see docs/prod_deployed.md for the keys and their sha256s).
ckpt/**/*.pt
*.npz

# Ingested shards and derived numeric artifacts — 40 GB, rebuildable from S3.
data/
plots/data/
*.u16
*.npy

# scratch
*.log
*.bak
.DS_Store

# Visitor-reported feedback. Real usernames tied to gameplay, so it stays local
# and out of a public repo. play/saved/*.json is the golden regression suite
# (see docs/prod_deployed.md) and is ignored for the same reason -- it is real
# games under a real lichess name, so it stays on the machine that recorded it.
play/claims.jsonl
play/giveups.jsonl
play/saved/giveup_*.json

# unrelated file that happens to live in this directory
N.Y.C. Groceries Operator(s) RFP.pdf

# Visitor game recordings are personal play data — keep them local.
play/saved/*.json

# Runtime stores written by the server: the job queue and the games database,
# plus SQLite's WAL sidecars. Local play data, and regenerated on first run.
play/*.db
play/*.db-shm
play/*.db-wal
